APP_ENV=development
# Optional hosted-runtime role: api, all, relay, or worker. Explicit CLI commands take precedence.
APP_ROLE=
POSTGRES_USER=monierave
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monierave

DB_SOURCE=postgresql://monierave:change-me@postgres:5432/monierave?sslmode=disable
DB_TEST_SOURCE=postgresql://monierave:change-me@localhost:5432/monierave_test?sslmode=disable
DB_MAX_CONNS=4
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
SERVER_ADDRESS=0.0.0.0:8080
LOG_LEVEL=info
SECRET_KEY=replace-with-at-least-32-random-characters
OPERATIONS_TOKEN=replace-with-a-separate-32-character-random-token
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
REFRESH_COOKIE_NAME=monierave_refresh
DEVICE_COOKIE_NAME=monierave_device
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=http://localhost:3000

REDIS_ADDRESS=redis:6379
# Hosted environments should set REDIS_URL instead, for example rediss://default:password@host:port/0.
REDIS_URL=
WORKER_CONCURRENCY=10
RELAY_BATCH_SIZE=50
RELAY_POLL_INTERVAL=1s
RELAY_CLAIM_LEASE=30s

MAILER_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Monierave <no-reply@example.com>
RESEND_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:8080
EMAIL_VERIFICATION_DURATION=24h
ENFORCE_EMAIL_VERIFICATION=true
PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range
PASSWORD_BREACH_CHECK_TIMEOUT=2s
PASSWORD_BREACH_CACHE_TTL=24h
